# ---------- Stratum ----------
STRATUM_HOST=0.0.0.0
STRATUM_PORT=8800
STRATUM_WORKSPACE=./workspace

# Notebook kernels
KERNEL_NAME=python3
SPARK_AUTO_INIT=true
SPARK_INIT_FILE=./config/spark_init.py
SQL_ROW_LIMIT=1000

# ---------- Catalog ----------
# metastore = read Hive Metastore Postgres directly (fast); spark = SHOW/DESCRIBE via Spark
CATALOG_BACKEND=metastore
# Any *_FILE variant reads the value from a file (e.g. METASTORE_DSN_FILE=./secrets/metastore_dsn)
METASTORE_DSN=postgresql://hiveuser:password@yourserver.postgres.database.azure.com:5432/hive_metastore?sslmode=require

# ---------- Spark session (used by config/spark_init.py) ----------
SPARK_APP_NAME=stratum-notebook
SPARK_MASTER=local[*]
BASE_PATH=abfss://poc-sandbox@youraccount.dfs.core.windows.net
ADLS_ACCOUNT=youraccount
ADLS_KEY_FILE=./secrets/adls_key
HMS_JDBC_URL=jdbc:postgresql://yourserver.postgres.database.azure.com:5432/hive_metastore?sslmode=require
HMS_USER=hiveuser
HMS_PASSWORD_FILE=./secrets/hms_password

# ---------- Workflows (Airflow) ----------
AIRFLOW_URL=http://localhost:8080
# v2 = Airflow 3.x (JWT via /auth/token), v1 = Airflow 2.x (basic auth)
AIRFLOW_API_VERSION=v2
AIRFLOW_USER=admin
AIRFLOW_PASSWORD_FILE=./secrets/airflow_password

# ---------- Compute (Spark Operator on Kubernetes) ----------
K8S_ENABLED=false
SPARK_NAMESPACE=spark

# ---------- Dora (AI assistant) ----------
# Free + private: Ollama on this machine (install: winget install Ollama.Ollama ; then: ollama pull qwen2.5-coder:7b)
DORA_BASE_URL=http://localhost:11434/v1
DORA_MODEL=qwen2.5-coder:7b
# Free cloud alternatives (need a free API key; notebook code and table names are sent to the provider):
#   Groq:       DORA_BASE_URL=https://api.groq.com/openai/v1                        DORA_MODEL=llama-3.3-70b-versatile
#   Gemini:     DORA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   DORA_MODEL=gemini-2.0-flash
#   Claude:     DORA_BASE_URL=https://api.anthropic.com/v1                       DORA_MODEL=claude-sonnet-5
#   OpenRouter: DORA_BASE_URL=https://openrouter.ai/api/v1                          DORA_MODEL=qwen/qwen-2.5-coder-32b-instruct:free
# DORA_API_KEY_FILE=./secrets/dora_api_key

# Stop idle notebook/SQL kernels after N minutes (0 = never)
KERNEL_IDLE_MINUTES=60

# Sign-in (first visit creates the admin account). false = no login (single-user laptop only)
AUTH_ENABLED=true
SESSION_HOURS=12

# Airflow DAG studio (Airflow page) - deploy DAGs without kubectl
# folder: write into the DAGs folder Airflow reads (docker-compose / WSL mount)
# git:    AIRFLOW_DAGS_DIR is a clone of the repo Airflow's git-sync pulls; Save & deploy commits and pushes
AIRFLOW_DAGS_MODE=folder
AIRFLOW_DAGS_DIR=./dags
AIRFLOW_DAGS_GIT_BRANCH=main
AIRFLOW_DAGS_GIT_SUBDIR=
